# mock = built-in sample data (default; shows a "Sample data" label).
# api  = real campaign data from the dashboard backend (see INTEGRATION_NOTES.md -> Going live with real data).
VITE_DASHBOARD_PROVIDER=mock

# Backend location. Empty = same origin (/api/dashboard/...). In npm run dev, /api is proxied to http://localhost:8086.
# Never put Karix keys or secrets here: everything in a VITE_ variable is visible in the browser.
VITE_API_BASE_URL=https://spleen-animator-purebred.ngrok-free.dev/
