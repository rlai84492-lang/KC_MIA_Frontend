# Backend location. Empty = same origin (/api/dashboard/...).
# In npm run dev, Vite forwards /api to BACKEND_URL (no CORS needed).
# Never put Karix keys or secrets here: everything in a VITE_ variable is visible in the browser.
VITE_API_BASE_URL=

# Backend that `npm run dev` forwards /api to.
BACKEND_URL=https://karvachauth-rlai.indiasouthcentral.cloudapp.azure.com
